---
import { Image } from "astro:assets";
import imgzapatilla from "./../images/calzado/zapatillas1.png";
---

<section class="w-full rounded-2xl">
  <h2 class="text-2xl font-bold">Listado de Calzado</h2>
  <ul class="grid list-none grid-cols-1">
    <li>
      <article class="p-0 transition-all duration-300 hover:-translate-y-1">
        <div
          class="bg-primary/10 overflow-hidden rounded-2xl border border-white/10 shadow-xl shadow-black/50"
        >
          <div class="aspect-video overflow-hidden">
            <Image
              alt="Nike Metcon"
              src={imgzapatilla}
              class="h-full w-full object-cover transition-transform duration-500 hover:scale-110"
            />
          </div>

          <div class="flex items-center justify-between p-4">
            <p
              class="bg-primary/20 text-primary w-min rounded-lg px-3 py-1 text-xs font-bold tracking-wider uppercase"
            >
              Análisis
            </p>
            <p class="text-sm text-slate-400">5 min de lectura</p>
          </div>

          <h3 class="p-0">
            <a
              class="hover:text-primary block text-xl font-bold text-white capitalize transition-colors"
              href="#"
            >
              Nike Metcon 9: El análisis definitivo
            </a>
          </h3>
          <p class="line-clamp-2 text-sm">
            Lorem Ipsum is simply dummy text of the printing and typesetting
            industry. Lorem Ipsum has been the industry's standard dummy text
            ever since the 1500s, when an unknown printer took a galley of type
            and scrambled it to make a type specimen book. It has survived not
            only five centuries, but also the leap into electronic typesetting,
            remaining essentially unchanged. It was popularised in the 1960s
            with the release of Letraset sheets containing Lorem Ipsum passages,
            and more recently with desktop publishing software like Aldus
            PageMaker including versions of Lorem Ipsum.
          </p>
        </div>
      </article>
    </li>
  </ul>
</section>

