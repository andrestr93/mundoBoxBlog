---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Clock from "./icons/Clock.astro";
import Arrow from "./icons/arrow.astro";
import { formatDistanceToNow } from "date-fns";
import { es } from "date-fns/locale"; // <-- Asegúrate de que tiene las llaves

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;

const { data } = post;

const {
  title,
  image,
  category,
  time,
  rating,
  pubDate,
  metaDescription,
  tags,
  slug,
} = data;

// Convierte el string a objeto Date y saca la distancia
const tiempoPublicado = formatDistanceToNow(new Date(pubDate), {
  addSuffix: true,
  locale: es,
});
---

<section class="rounded-2xl">
  <div>
    <article
      class="group relative transition-all duration-300 hover:-translate-y-1"
    >
      <div
        class="hover:bg-primary/10 rounded-2xl border border-white/10 shadow-xl shadow-black/50"
      >
        <div class="aspect-video h-full w-full">
          <Image
            width={800}
            height={450}
            alt={title}
            src={image}
            quality="mid"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="px-4 py-2">
          <div class="flex items-center">
            <p
              class="bg-primary/20 text-primary font-barlow-condensed h-min w-min rounded-lg px-3 py-1 tracking-wider uppercase"
            >
              {category}
            </p>
            <div class="flex items-center justify-end p-0">
              <Clock class="h-12 w-12" />
              <time
                class="font-barlow-condensed text-primary capitalize"
                datetime={pubDate.toString()}
              >
                {tiempoPublicado}
              </time>
            </div>
          </div>
        </div>

        <h3>
          <a
            class="font-bold text-white capitalize transition-colors"
            href={`/${category.toLowerCase()}/${slug}`}
          >
            <span class="absolute inset-0" aria-hidden="true"></span>

            {title}
          </a>
        </h3>
        <p class="font-barlow-condensed text-slate-300">{metaDescription}</p>
        <div class="flex items-center justify-start gap-0">
          <p class="font-barlow-condensed w-fit text-lg font-bold uppercase">
            Leer articulo
          </p>
          <p class="w-auto">
            <Arrow class="h-10" />
          </p>
        </div>
      </div>
    </article>
  </div>
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org/",
      "@type": "Review",
      itemReviewed: {
        "@type": "Product",
        name: post.data.title,
        image: image,
      },
      reviewRating: {
        "@type": "Rating",
        ratingValue: rating,
        bestRating: "5",
      },
      author: {
        "@type": "Organization",
        name: "MundoBox",
      },
    })}
  />
</section>
;

