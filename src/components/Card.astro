---
import { Image } from "astro:assets";
import Clock from "./icons/Clock.astro";
import Arrow from "./icons/arrow.astro";

import { formatDistanceToNowStrict } from "date-fns";
import { es } from "date-fns/locale";

const { post } = Astro.props;

const { data } = post;

const { title, image, category, type, pubDate, metaDescription, slug } = data;

// Convierte el string a objeto Date y saca la distancia
const publishTime = formatDistanceToNowStrict(new Date(pubDate), {
  locale: es,
  roundingMethod: "floor",
});
---

<section class="rounded-2xl">
  <div>
    <article
      class="group relative transition-all duration-300 hover:-translate-y-1"
    >
      <div
        class="hover:bg-primary/10 mx-auto max-w-100 rounded-2xl border border-white/10 p-5 shadow-xl shadow-black/50"
      >
        <div>
          <Image
            width={800}
            height={800}
            alt={title}
            transition:name="product"
            src={image}
            quality="mid"
            class="h-full w-full object-cover"
          />
        </div>

        <div class="flex items-center justify-between">
          <p
            class="bg-primary/20 text-primary font-barlow-condensed w-fit rounded-lg px-3 py-1 font-bold tracking-wider uppercase italic"
          >
            {category}
          </p>
          <div class="flex w-fit items-center p-0">
            <Clock class="h-12 w-7" />
            <time
              class="font-barlow-condensed text-primary text-right text-lg font-semibold capitalize italic"
              datetime={pubDate.toString()}
            >
              Hace {publishTime}
            </time>
          </div>
        </div>

        <h3>
          <a
            class="font-barlow-condensed font-bold tracking-tighter text-white uppercase italic transition-colors"
            href={`/${category.toLowerCase()}/${slug}`}
          >
            <span class="absolute inset-0" aria-hidden="true"></span>

            {title}
          </a>
        </h3>
        <p class="font-barlow-condensed font-bold text-slate-400 italic">
          {metaDescription}
        </p>
        <div class="flex items-center justify-between">
          <div class="flex items-center justify-start gap-0">
            <p
              class="font-barlow-condensed w-fit text-lg font-bold uppercase italic"
            >
              Leer articulo
            </p>
            <p class="w-auto">
              <Arrow class="h-10" />
            </p>
          </div>
          <p
            class="bg-primary/5 text-primary font-barlow-condensed w-fit rounded-lg px-3 py-1 font-bold tracking-wider uppercase italic"
          >
            {type}
          </p>
        </div>
      </div>
    </article>
  </div>
</section>
