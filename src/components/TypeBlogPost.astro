---
import { getCollection } from "astro:content";
const blogPosts = await getCollection("blog");
---

<h1>My posts</h1>
<ul>
  {
    blogPosts.map((post) => (
      <li>
        <a href={`${post.data.category.toLowerCase()}/${post.id}`}>
          {post.data.title}
        </a>
      </li>
    ))
  }
</ul>
