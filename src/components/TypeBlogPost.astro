---
import { getPublishedPosts } from "./../lib/posts";
const blogPosts = await getPublishedPosts();
---

<h1>My posts</h1>
<ul>
  {
    blogPosts.map((post) => (
      <li>
        <a href={`${post.data.category.toLowerCase()}/${post.id}`}>
          {post.data.title}
        </a>
      </li>
    ))
  }
</ul>
