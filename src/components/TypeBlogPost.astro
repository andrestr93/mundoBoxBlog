---
import { getCollection, type CollectionEntry } from "astro:content";
const blogPosts = await getCollection("blog");
interface Props {
  post: CollectionEntry<"blog">;
}
---

<h1>My posts</h1>
<ul>
  {
    blogPosts.map((post) => (
      <li>
        <a href={`/articulos/blog/${post.id}`}>{post.data.title}</a>
      </li>
    ))
  }
</ul>
