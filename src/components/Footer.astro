---
import Logo from "../shared/components/Logo.astro";
import NavbarFooter from "../shared/components/NavbarFooter.astro";

const { class: className, delay = "0s" } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer
  class="p-0"
  class:list={["reveal", className]}
  style={`animation-delay: ${delay};`}
>
  <section class="flex items-center">
    <Logo
      class="font-barlow-condensed text-3xl leading-none font-black tracking-tighter md:text-7xl"
    />
    <NavbarFooter />
  </section>
  <p class="px-4 text-center text-xs text-gray-400">
    En calidad de Afiliado de Amazon, obtengo ingresos por las compras
    adscritas que cumplen los requisitos aplicables.
  </p>
  <section class="flex items-center justify-between">
    <p class="font-barlow-condensed w-fit text-center text-sm md:text-xl">
      &copy; {currentYear} MundoBox — Todos los derechos reservados.
    </p>
    <p class="font-barlow-condensed w-fit text-center text-sm md:text-xl">
      Creada por andrestr93 💚
    </p>
  </section>
</footer>
