---
import Navbar from "../shared/components/Navbar.astro";
import Logo from "../shared/components/Logo.astro";
const { class: className, delay = "0s" } = Astro.props;
---

<header
  class:list={["reveal relative z-1000 w-full", className]}
  style={`animation-delay: ${delay};`}
>
  <div class="flex w-full flex-row items-center justify-center">
    <Logo
      class="font-barlow-condensed text-4xl leading-none font-black tracking-tighter md:text-6xl"
    />

    <Navbar />
  </div>
</header>
