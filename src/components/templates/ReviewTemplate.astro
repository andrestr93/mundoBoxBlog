---
import { Image } from "astro:assets";
import imgzapatilla from "./../../images/calzado/zapatillas1.png";
import Start from "../icons/Start.astro";
import Check from "../icons/Check.astro";
import SearchButtonAmazon from "./../../components/SearchButtonAmazon.astro";
import ThumbUp from "../icons/ThumbUp.astro";
import Plus from "../icons/Plus.astro";
import ThumpDown from "../icons/ThumpDown.astro";
import Less from "../icons/Less.astro";
import Ripple from "../icons/Ripple.astro";
import Shield from "../icons/Shield.astro";
import Bolt from "../icons/Bolt.astro";
import { propsToFilename } from "astro/assets";

const {
  title,
  image,
  pros,
  contras,
  characteristics,
  category,
  time,
  rating,
  metaDescription,
  tags,
  slug,
} = Astro.props;
---

<article>
  <header>
    <Image
      alt="Imagen home"
      loading="eager"
      quality="high"
      format="webp"
      src={image}
    />
    <h1 class="w-full text-center text-4xl">{title}</h1>
  </header>
  <section>
    <div class="flex items-center">
      <Start class="h-12 w-12" />
      <span class="text-primary font-bold">(rating)</span>
    </div>
  </section>

  <section class="bg-primary/10 m-auto flex w-[90%] flex-col rounded-2xl p-0.5">
    <div class="flex flex-row-reverse items-center">
      <h2 class="text-2xl text-white">Caracteristicas Clave</h2>
      <Check class="h-12 w-12" />
    </div>

    <ul>
      {
        characteristics.map((characteristic: string) => (
          <li class="flex items-start">
            <Check class="h-12 w-12 text-green-400" aria-hidden="true" />
            <p>{characteristic}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section>
    <SearchButtonAmazon />
  </section>

  <section
    class="m-auto mt-8 mb-8 flex w-[90%] flex-col rounded-2xl bg-green-950/30 p-0.5"
  >
    <div class="flex flex-row-reverse items-center">
      <h2 class="text-2xl text-white">Pros</h2>
      <ThumbUp class="h-12 w-12" />
    </div>

    <ul>
      <ul>
        {
          pros.map((pro: string) => (
            <li class="flex items-start">
              <Plus class="h-12 w-12 text-green-400" aria-hidden="true" />
              <p>{pro}</p>
            </li>
          ))
        }
      </ul>
    </ul>
  </section>
  <section
    class="m-auto mt-8 mb-8 flex w-[90%] flex-col rounded-2xl bg-red-950/30 p-0.5"
  >
    <div class="flex flex-row-reverse items-center">
      <h2 class="text-2xl text-white">Contras</h2>
      <ThumpDown class="h-12 w-12" />
    </div>

    <ul>
      <ul>
        {
          contras.map((contra: string) => (
            <li class="flex items-start">
              <Less class="h-12 w-12 text-green-400" aria-hidden="true" />
              <p>{contra}</p>
            </li>
          ))
        }
      </ul>
    </ul>
  </section>

  <section
    class="bg-primary/10 m-auto mt-8 mb-8 flex w-[90%] flex-col rounded-2xl p-0.5"
  >
    <div class="flex flex-row-reverse items-end justify-center">
      <h2 class="text-3xl text-white">Analisis Detallado</h2>
      <Ripple class="h-12 w-12" />
    </div>

    <ul>
      <li class="flex flex-col">
        <div class="flex p-0">
          <Shield class="h-12 w-12" aria-hidden="true" />
          <h3 class="font-body text-2xl font-bold">Durabilidad</h3>
        </div>
        <p>
          Lorem Ipsum is simply dummy text of the printing and typesetting
          industry. Lorem Ipsum has been the industry's standard dummy text ever
          since the 1500s, when an unknown printer took a galley of type and
          scrambled it to make a type specimen book. It has survived not only
          five centuries, but also the leap into electronic typesetting,
          remaining essentially unchanged. It was popularised in the 1960s with
          the release of Letraset sheets containing Lorem Ipsum passages, and
          more recently with desktop publishing software like Aldus PageMaker
          including versions of Lorem Ipsum.
        </p>
      </li>
      <li class="flex flex-col">
        <div class="flex p-0">
          <Ripple class="h-12 w-12" aria-hidden="true" />
          <h3 class="font-body text-2xl font-bold">Comodidad</h3>
        </div>
        <p>
          Lorem Ipsum is simply dummy text of the printing and typesetting
          industry. Lorem Ipsum has been the industry's standard dummy text ever
          since the 1500s, when an unknown printer took a galley of type and
          scrambled it to make a type specimen book. It has survived not only
          five centuries, but also the leap into electronic typesetting,
          remaining essentially unchanged. It was popularised in the 1960s with
          the release of Letraset sheets containing Lorem Ipsum passages, and
          more recently with desktop publishing software like Aldus PageMaker
          including versions of Lorem Ipsum.
        </p>
      </li>
      <li class="flex flex-col">
        <div class="flex p-0">
          <Bolt class="h-12 w-12" aria-hidden="true" />
          <h3 class="font-body text-2xl font-bold">Rendimiento</h3>
        </div>
        <p>
          Lorem Ipsum is simply dummy text of the printing and typesetting
          industry. Lorem Ipsum has been the industry's standard dummy text ever
          since the 1500s, when an unknown printer took a galley of type and
          scrambled it to make a type specimen book. It has survived not only
          five centuries, but also the leap into electronic typesetting,
          remaining essentially unchanged. It was popularised in the 1960s with
          the release of Letraset sheets containing Lorem Ipsum passages, and
          more recently with desktop publishing software like Aldus PageMaker
          including versions of Lorem Ipsum.
        </p>
      </li>
    </ul>
  </section>
</article>
