---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { Image } from "astro:assets";
import Bolt from "../icons/Bolt.astro";
import Check from "../icons/Check.astro";
import EmptyStart from "../icons/EmptyStart.astro";
import Less from "../icons/Less.astro";
import Plus from "../icons/Plus.astro";
import Report from "../icons/Report.astro";
import Ripple from "../icons/Ripple.astro";
import Shield from "../icons/Shield.astro";
import Start from "../icons/Start.astro";
import ThumbUp from "../icons/ThumbUp.astro";
import ThumpDown from "../icons/ThumpDown.astro";
import SearchButtonAmazon from "../SearchButtonAmazon.astro";

interface Details {
  title: string;
  content: string;
  icon: "shield" | "bolt" | "ripple";
}

const {
  title,
  name,
  image,
  rating,
  reviewCount,
  amazonLink,
  characteristics,
  pros,
  contras,
} = Astro.props;

const fullStars = Math.round(rating);
const emptyStars = 5 - fullStars;
---

<article>
  <header class="mx-auto grid max-w-6xl grid-cols-1 md:grid-cols-2">
    <div>
      <Image
        quality="low"
        widths={[1024]}
        transition:name="product"
        format="png"
        alt={name}
        loading="eager"
        src={image}
      />
    </div>
    <div class="rounded-2xl">
      <h1 class="text-3xl md:text-5xl">
        {title}
      </h1>
      <div
        class="flex w-fit items-center p-0"
        class="flex w-fit items-center p-0"
        aria-label={`Puntuación de ${rating} basada en ${reviewCount} reseñas`}
      >
        <div class="flex p-0">
          {
            // Pintamos las estrellas llenas
            Array.from({ length: fullStars }).map((_) => (
              <span>
                <Start />{" "}
              </span>
            ))
          }
          {
            // Pintamos las estrellas vacías
            Array.from({ length: emptyStars }).map((_) => (
              <span>
                {" "}
                <EmptyStart />{" "}
              </span>
            ))
          }
        </div>
        <div>
          <p class="text-medium text-primary font-barlow-condensed w-max p-0">
            ({rating}/5 de {reviewCount} reseñas)
          </p>
        </div>
      </div>
      <div class="bg-primary/15 rounded-2xl">
        <div class="flex flex-row-reverse items-center">
          <p class="p-0 font-bold text-white uppercase">
            Caracteristicas Clave
          </p>
          <Report class="h-13 w-13" />
        </div>

        <ul class="p-0">
          {
            characteristics.map((characteristic: string) => (
              <li class="flex items-center">
                <Check class="h-12 w-12 text-green-400" aria-hidden="true" />
                <p class="p-0">{characteristic}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <SearchButtonAmazon amazonUrl={amazonLink} />
        <p class="text-primary text-center text-xs font-bold">
          Ganamos una pequeña comisión si compras a través de este enlace sin
          coste extra para ti
        </p>
      </div>
    </div>
  </header>
  <section class="mx-auto grid max-w-6xl grid-cols-1 gap-5 md:grid-cols-2">
    <div class="rounded-2xl bg-green-950/50 p-0">
      <div class="flex flex-row-reverse items-center p-0">
        <h2 class="text-green-500">Pros</h2>
        <ThumbUp class="h-12 w-12" />
      </div>

      <ul class="p-0">
        {
          pros.map((pro: string) => (
            <li class="flex items-center p-0">
              <Plus class="h-12 w-12 text-green-400" aria-hidden="true" />
              <p>{pro}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-2xl bg-red-950/50 p-0">
      <div class="flex flex-row-reverse items-center p-0">
        <h2 class="text-red-500">Contras</h2>
        <ThumpDown class="h-12 w-12" />
      </div>

      <ul class="p-0">
        {
          contras.map((contra: string) => (
            <li class="flex items-center p-0">
              <Less class="h-10 w-10" />
              <p>{contra}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    class="bg-primary/5 mx-auto mt-8 mb-8 flex max-w-5xl flex-col rounded-2xl px-4 py-2"
  >
    <div class="flex flex-row-reverse items-center">
      <h2 class="font-bold text-white">Analisis Detallado</h2>
      <Ripple class="h-15 w-15" />
    </div>
    <slot />
  </section>
</article>
