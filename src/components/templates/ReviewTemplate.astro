---
import { Image } from "astro:assets";
import Start from "../icons/Start.astro";
import Check from "../icons/Check.astro";
import SearchButtonAmazon from "./../../components/SearchButtonAmazon.astro";
import ThumbUp from "../icons/ThumbUp.astro";
import Plus from "../icons/Plus.astro";
import ThumpDown from "../icons/ThumpDown.astro";
import Less from "../icons/Less.astro";
import Ripple from "../icons/Ripple.astro";
import Shield from "../icons/Shield.astro";
import Bolt from "../icons/Bolt.astro";
import Report from "../icons/Report.astro";

const {
  title,
  image,
  pros,
  contras,
  characteristics,
  reviewsCount,
  rating,
  comfort,
  metaTitle,
  performance,
  durability,
} = Astro.props;
---

<article>
  <header
    class="mx-auto grid max-w-3xl grid-cols-1 md:grid-cols-2 lg:grid-cols-3"
  >
    <div>
      <Image
        quality="high"
        format="webp"
        widths={[768, 1024]}
        alt=` ${metaTitle}`
        class="h-full w-full object-cover"
        fetchpriority={"high"}
        loading="eager"
        src={image}
      />
    </div>
    <div class="bg-primary/10 rounded-2xl">
      <h1>
        {title}
      </h1>
      <div class="flex items-center">
        <Start class="h-10 w-10" />
        <p class="text-primary text-xs font-bold">{rating}/{reviewsCount}</p>
      </div>
      <div class="flex flex-row-reverse items-center">
        <p class="p-0 text-sm font-bold text-white uppercase">
          Caracteristicas Clave
        </p>
        <Report class="h-12 w-12" />
      </div>

      <ul class="p-0">
        {
          characteristics.map((characteristic: string) => (
            <li class="flex items-center">
              <Check class="h-10 w-10 text-green-400" aria-hidden="true" />
              <p class="p-0">{characteristic}</p>
            </li>
          ))
        }
      </ul>
      <SearchButtonAmazon />
    </div>
  </header>
  <section
    class="mx-auto grid max-w-3xl grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3"
  >
    <div class="rounded-2xl bg-green-950/50 p-0">
      <div class="flex flex-row-reverse items-center p-0">
        <h3 class="text-green-500">Pros</h3>
        <ThumbUp class="h-12 w-12" />
      </div>

      <ul class="p-0">
        {
          pros.map((pro: string) => (
            <li class="flex items-center p-0">
              <Plus class="h-12 w-12 text-green-400" aria-hidden="true" />
              <p class="leading-none">{pro}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="rounded-2xl bg-red-950/50 p-0">
      <div class="flex flex-row-reverse items-center p-0">
        <h3 class="text-red-500">Contras</h3>
        <ThumpDown class="h-12 w-12" />
      </div>

      <ul class="p-0">
        {
          contras.map((contra: string) => (
            <li class="flex items-center p-0">
              <Less class="h-10 w-10" />
              <p class="p-0">{contra}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section
    class="bg-primary/10 mx-auto mt-8 mb-8 flex max-w-xl flex-col rounded-2xl p-0.5"
  >
    <div class="flex flex-row-reverse items-center">
      <h2 class="font-bold text-white">Analisis Detallado</h2>
      <Ripple class="h-12 w-12" />
    </div>

    <ul class="p-5">
      <li class="flex flex-col">
        <div class="flex items-center p-0">
          <Shield class="h-12 w-12" aria-hidden="true" />
          <h3 class="font-bold">Durabilidad</h3>
        </div>

        <p>{durability}</p>
      </li>
      <li class="flex flex-col">
        <div class="flex items-center p-0">
          <Ripple class="h-12 w-12" aria-hidden="true" />
          <h3 class="font-bold">Comodidad</h3>
        </div>
        <p>{comfort}</p>
      </li>
      <li class="flex flex-col">
        <div class="flex items-center p-0">
          <Bolt class="h-12 w-12" aria-hidden="true" />
          <h3 class="font-bold">Rendimiento</h3>
        </div>
        <p>{performance}</p>
      </li>
    </ul>
  </section>
</article>
