---
import { getCollection } from "astro:content";
import Menu from "../../components/icons/Menu.astro";

const posts = await getCollection("blog");

const categories = [
  ...new Set(posts.map((post) => post.data.category.toLowerCase())),
];
---

<nav
  class="font-lexend hidden w-full flex-row items-center justify-center gap-6 p-0 text-3xl capitalize md:flex"
>
  {
    categories.map((cat) => (
      <a href={`/${cat}`} class="hover:text-primary">
        {cat}
      </a>
    ))
  }

  <a class="hover:text-primary text-white transition-colors" href="/sobremi"
    >Sobre mi</a
  >
</nav>

<div class="border-white/10 text-white">
  <button id="open-menu" class="flex justify-end focus:outline-none md:hidden">
    <button
      id="open-menu"
      class="flex justify-end focus:outline-none md:hidden"
    >
      <Menu class="h-12 w-12" />
    </button>

    <nav
      id="box-menu"
      class="fixed top-0 right-0 h-full w-full translate-x-full flex-col bg-black text-center transition-transform duration-300 ease-in-out md:hidden"
      id="box-menu"
      class="fixed top-0 right-0 h-full w-full translate-x-full flex-col bg-black text-center transition-transform duration-300 ease-in-out md:hidden"
    >
      <div>
        <button
          class="text-primary flex justify-end px-5 text-4xl"
          id="close-menu">×</button
        >
        <div class="flex flex-col text-2xl">
          {categories.map((cat) => <a href={`/${cat}`}>{cat}</a>)}
          <a href="/sobremi">Sobre mi</a>
        </div>
        <div>
          <button
            class="text-primary flex justify-end px-5 text-4xl"
            id="close-menu">×</button
          >
          <div class="flex flex-col text-2xl">
            {categories.map((cat) => <a href={`/${cat}`}>{cat}</a>)}
            <a href="/sobremi">Sobre mi</a>
          </div>
        </div>
      </div>
    </nav>

    <script>
      const menuMobile = () => {
        const butOpen = document.getElementById("open-menu");
        const butClose = document.getElementById("close-menu");
        const boxMenu = document.getElementById("box-menu");

        butOpen?.addEventListener("click", () => {
          boxMenu?.classList.toggle("translate-x-0");
          boxMenu?.classList.toggle("translate-x-full");
        });

        butClose?.addEventListener("click", () => {
          boxMenu?.classList.toggle("translate-x-full");
          boxMenu?.classList.toggle("translate-x-0");
        });
      };

      menuMobile();
      // Si usas transiciones de página en Astro, esto lo reinicia al cambiar de URL
      document.addEventListener("astro:after-swap", menuMobile);
    </script>
  </button>
</div>
