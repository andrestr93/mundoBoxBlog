---
import { getCollection } from "astro:content";
import Menu from "../../components/icons/Menu.astro";

const posts = await getCollection("blog");

const categories = [
  ...new Set(posts.map((post) => post.data.category.toLowerCase())),
];
---

<nav
  class="font-lexend flex hidden w-full flex-row items-center justify-center gap-6 p-0 text-xl capitalize md:flex"
>
  {
    categories.map((cat) => (
      <a href={`/${cat}`} class="hover:text-primary">
        {cat}
      </a>
    ))
  }
</nav>

<div class="border-white/10 text-white">
  <button id="boton-menu" class="flex justify-end focus:outline-none md:hidden">
    <Menu class="h-12 w-12" />
  </button>

  <nav
    id="caja-menu"
    class="fixed left-0 z-[9999] flex hidden w-full flex-col bg-black shadow-2xl md:hidden"
  >
    {
      categories.map((cat) => (
        <a href={`/${cat}`} class="hover:text-primary text-center">
          {cat}
        </a>
      ))
    }
  </nav>
</div>
<script>
  const menuMobile = () => {
    const boton = document.getElementById("boton-menu");
    const caja = document.getElementById("caja-menu");

    boton?.addEventListener("click", () => {
      // Abre o cierra el menú
      caja?.classList.toggle("hidden");
    });
  };

  menuMobile();
  // Si usas transiciones de página en Astro, esto lo reinicia al cambiar de URL
  document.addEventListener("astro:after-swap", menuMobile);
</script>
