---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const categories = [
  ...new Set(posts.map((post) => post.data.category.toLowerCase())),
];
---

<nav
  class="flex w-full flex-row items-center justify-center gap-6 p-0 text-xl capitalize"
>
  {
    categories.map((cat) => (
      <a
        href={`/${cat}`}
        class="hover:text-primary hover:decoration-primary underline underline-offset-4"
      >
        {cat}
      </a>
    ))
  }
</nav>
