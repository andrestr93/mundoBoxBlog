---
import { ClientRouter } from "astro:transitions";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  isHome?: boolean;
  isNotIndex?: boolean;
  ogType?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  schema?: Record<string, unknown> | null;
}

const {
  title,
  description,
  image,
  isHome = false,
  isNotIndex = false,
  ogType = "website",
  publishedTime,
  modifiedTime,
  schema = null,
} = Astro.props;

const site = Astro.site!.href.replace(/\/$/, "");
const relativeImage = image ?? `/default.png`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const socialImageURL = new URL(relativeImage, Astro.site).href;
const imageType = socialImageURL.endsWith(".webp")
  ? "image/webp"
  : socialImageURL.endsWith(".jpg") || socialImageURL.endsWith(".jpeg")
    ? "image/jpeg"
    : "image/png";

const homeSchema = isHome
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": `${site}/#website`,
          url: `${site}/`,
          name: "MundoBox",
          description,
          publisher: { "@id": `${site}/#organization` },
          inLanguage: "es-ES",
        },
        {
          "@type": "Organization",
          "@id": `${site}/#organization`,
          name: "MundoBox",
          url: `${site}/`,
          logo: {
            "@type": "ImageObject",
            url: `${site}/logo.png`,
          },
        },
      ],
    }
  : null;
---

<!doctype html>
<html lang="es-ES" prefix="og: https://ogp.me/ns#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" />

    <meta
      name="robots"
      content={isNotIndex
        ? "noindex, follow"
        : "index, follow, max-image-preview:large, max-snippet:-1"}
    />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="MundoBox" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:type" content={imageType} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {
      modifiedTime && (
        <meta
          property="article:modified_time"
          content={modifiedTime.toISOString()}
        />
      )
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImageURL} />
    <meta
      name="google-site-verification"
      content="obdZR3ImUTWfkcDb2xxlY-4EOKMLYtgma64kgWfNB-U"
    />
    <ClientRouter />

    {
      homeSchema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(homeSchema)}
        />
      )
    }
    {
      schema && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema)}
        />
      )
    }
  </head>
  <body>
    <Header />

    <main class="mb-5 w-full p-0">
      <slot />
    </main>
    <Footer />
  </body>
</html>
