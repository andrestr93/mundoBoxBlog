---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import CategoryLayout from "../../layouts/CategoryLayout.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  const uniqueCategories = [
    ...new Set(allPosts.map((post) => post.data.category.toLowerCase())),
  ];

  return uniqueCategories.map((category) => ({
    params: { category },
    props: {
      categoryName: category,
      posts: allPosts
        .filter((post) => post.data.category.toLowerCase() === category)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { posts, categoryName } = Astro.props;
const year = new Date().getFullYear();
const site = Astro.site!.href.replace(/\/$/, "");
const categoryUrl = `${site}/${categoryName}/`;
const label = categoryName.charAt(0).toUpperCase() + categoryName.slice(1);

// Títulos y descripciones pensados para búsquedas reales de cada categoría
const seo: Record<string, { title: string; description: string }> = {
  zapatillas: {
    title: `Mejores Zapatillas de CrossFit ${year}: Análisis y Opiniones`,
    description: `Las mejores zapatillas de CrossFit de ${year} probadas en el box: Reebok Nano, Nike Metcon y más. Cuál elegir según tu WOD, pie ancho y presupuesto.`,
  },
  calleras: {
    title: `Mejores Calleras de CrossFit ${year}: Guía de Compra`,
    description: `Calleras de CrossFit de cuero y sintéticas analizadas. Cuál comprar según tu nivel, 2 o 3 agujeros y cómo elegir la talla correcta.`,
  },
  combas: {
    title: `Mejores Combas de CrossFit ${year} para Dobles`,
    description: `Combas de velocidad para CrossFit analizadas: cuál elegir para sacar los dobles, cable fino o grueso y cómo ajustar la longitud.`,
  },
  suplementos: {
    title: `Suplementos para CrossFit ${year}: Creatina y Proteína`,
    description: `Solo los suplementos para CrossFit que funcionan: creatina monohidrato, proteína whey y cómo tomarlos. Análisis honestos, sin humo.`,
  },
};

const { title, description } = seo[categoryName] ?? {
  title: `${label} para CrossFit ${year}: Análisis y Opiniones`,
  description: `Análisis honestos de ${categoryName} para CrossFit probados en el box.`,
};

const categorySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${categoryUrl}#webpage`,
      url: categoryUrl,
      name: title,
      description,
      inLanguage: "es-ES",
      isPartOf: { "@id": `${site}/#website` },
    },
    {
      "@type": "ItemList",
      itemListElement: posts.map((post, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `${categoryUrl}${post.id}/`,
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/` },
        { "@type": "ListItem", position: 2, name: label, item: categoryUrl },
      ],
    },
  ],
};
---

<MainLayout
  title={`${title} | MundoBox`}
  description={description}
  schema={categorySchema}
>
  <CategoryLayout posts={posts} categoryName={categoryName} />
</MainLayout>
