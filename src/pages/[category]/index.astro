---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Card from "../../components/Card.astro";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  // 1. Extraemos todas las categorías únicas que existen en tus MDX
  const uniqueCategories = [
    ...new Set(allPosts.map((post) => post.data.category.toLowerCase())),
  ];

  // 2. Por cada categoría, creamos una página
  return uniqueCategories.map((category) => {
    // Filtramos los posts que pertenecen a esta categoría específica
    const filteredPosts = allPosts.filter(
      (post) => post.data.category.toLowerCase() === category,
    );

    return {
      params: { category }, // Esto rellena el hueco de la URL (ej: /calzado)
      props: { posts: filteredPosts, categoryName: category }, // Pasamos los posts como "props"
    };
  });
}

const { posts, categoryName } = Astro.props;
---

<MainLayout
  image=""
  title={`Mejores ${categoryName} de Crossfit 2026 - Comparativa y Opiniones | MundoBox`}
  description=` ¿Buscas los mejores complementos para Crossfit? Analizamos los mejores para que tu solo te tengas que preocupar  `
>
  <h1 class="text-center text-2xl font-bold">Listado de {categoryName}</h1>
  <ul class="grid p-0 md:grid-cols-3 lg:grid-cols-4">
    {
      posts.map((post) => (
        <li>
          <Card post={post} />
        </li>
      ))
    }
  </ul>
</MainLayout>
