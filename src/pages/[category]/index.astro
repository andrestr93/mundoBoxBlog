---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Card from "../../components/Card.astro";

const getFullYear = new Date().getFullYear();
export async function getStaticPaths() {
  const allPosts = await getCollection("blog");

  const uniqueCategories = [
    ...new Set(allPosts.map((post) => post.data.category.toLowerCase())),
  ];

  return uniqueCategories.map((category) => {
    const filteredPosts = allPosts.filter(
      (post) => post.data.category.toLowerCase() === category,
    );

    return {
      params: { category },
      props: { posts: filteredPosts, categoryName: category },
    };
  });
}

const { posts, categoryName } = Astro.props;

const categoryUrl = `${Astro.site}/${categoryName}/`;

const categorySchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${categoryUrl}#webpage`,
      url: categoryUrl,
      name: `Mejores ${categoryName} de Crossfit ${getFullYear} - MundoBox`,
      description: `Descubre nuestra selección de las mejores ${categoryName} para Crossfit analizadas por expertos.`,
      isPartOf: { "@id": `${Astro.site}/#website` },
      breadcrumb: { "@id": `${categoryUrl}#breadcrumb` },
    },
    {
      "@type": "ItemList",
      name: `Mejores ${categoryName} de Crossfit ${getFullYear} - MundoBox`,
      description: `Descubre nuestra selección de las mejores ${categoryName} para Crossfit analizadas por expertos.`,
      itemListElement: posts.map((post, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: `${Astro.site}/blog/${post.data.slug}/`, // Ajusta esta ruta según tu estructura real de URLs
      })),
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${categoryUrl}#breadcrumb`,
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          item: {
            "@id": Astro.site,
            name: "MundoBox",
          },
        },
        {
          "@type": "ListItem",
          position: 2,
          item: {
            "@id": categoryUrl,
            name: categoryName,
          },
        },
      ],
    },
  ],
};
---

<MainLayout
  isHome={false}
  title={`Mejores ${categoryName} de Crossfit 2026 - Analisis y Opiniones | MundoBox`}
  description=`Descubre nuestra selección de las mejores ${categoryName} para Crossfit.`
>
  <script
    slot="schema-post"
    type="application/ld+json"
    set:html={JSON.stringify(categorySchema)}
  />
  <section class="mt-10 border-t border-white/10 px-4 pt-5">
    <div class="prose prose-invert mx-auto max-w-4xl">
      <h1 class="mb-6 text-center text-3xl font-bold text-white">
        Cómo elegir {categoryName} para entrenamientos de alta intensidad
      </h1>
      <p class="text-gray-400">
        En <strong>MundoBox</strong> no solo listamos productos. Para seleccionar
        cada
        {categoryName} de esta comparativa, hemos tenido en cuenta factores críticos
        como la <strong>estabilidad lateral</strong>, la <strong
          >transpirabilidad del tejido</strong
        >
        y su resistencia ante ejercicios específicos como el <em>Rope Climb</em> o
        los levantamientos de halterofilia.
      </p>
    </div>
    <ul class="grid max-w-full gap-6 p-0 md:grid-cols-3 lg:grid-cols-4">
      {
        posts.map((post) => (
          <li>
            <Card post={post} />
          </li>
        ))
      }
    </ul>
  </section>
  <section class="px-4"></section>
</MainLayout>
