---
// src/pages/[category]/[slug].astro
import { getCollection, render } from "astro:content";
import ReviewTemplate from "../../components/templates/ReviewTemplate.astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      // 1. Rellena la carpeta [category]
      category: post.data.category.toLowerCase().replace(/\s+/g, "-"),
      // 2. Rellena el archivo [slug].astro (usa el nombre del archivo mdx)
      slug: post.id,
    },
    props: { post },
  }));
}

const { post } = Astro.props;

const { image, rating, reviewsCount, title, metaDescription } = post.data;
const { Content } = await render(post);

const optimizedMetaImage = await getImage({
  src: image, // <--- AQUÍ: El objeto directo, SIN .src
  width: 1200,
  height: 630,
  format: "jpg", // JPG comprime mucho más que PNG o WebP para redes sociales
  quality: 70, // Calidad 70 es perfecta: invisible al ojo, muy ligera
});
---

<MainLayout
  title={title}
  description={metaDescription}
  image={optimizedMetaImage.src}
  rating={rating}
  reviewsCount={reviewsCount}
>
  {
    post.data.type === "Reviews" && (
      <ReviewTemplate {...post.data}>
        <Content />
      </ReviewTemplate>
    )
  }
</MainLayout>
