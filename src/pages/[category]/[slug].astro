---
// src/pages/[category]/[slug].astro
import { getCollection, render } from "astro:content";
import ReviewTemplate from "../../components/templates/ReviewTemplate.astro";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      // 1. Rellena la carpeta [category]
      category: post.data.category.toLowerCase().replace(/\s+/g, "-"),
      // 2. Rellena el archivo [slug].astro (usa el nombre del archivo mdx)
      slug: post.id,
    },
    props: { post },
  }));
}

const { post } = Astro.props;

const {
  image,
  rating,
  reviewCount,
  title,
  name,
  metaDescription,
  brand,
  pubDate,
} = post.data;
const { Content } = await render(post);

const schema = {
  "@context": "https://schema.org/",
  "@type": "Review", // El tipo principal es RESEÑA, no Producto
  headline: title,
  description: metaDescription,
  image: image,
  datePublished: pubDate || new Date().toISOString(),
  author: {
    "@type": "Person",
    name: "Andrés",
    url: "https://mundobox.blog/about",
  },
  publisher: {
    "@type": "Organization",
    name: "MundoBox",
    logo: {
      "@type": "ImageObject",
      url: "https://mundobox.blog/logo.png",
    },
  },
  itemReviewed: {
    "@type": "Product",
    name: title,
    image: image,
    brand: {
      "@type": "Brand",
      name: brand,
    },
    // TRUCO PARA AFILIADOS:
    // Añadimos una oferta vacía o genérica para "engañar" al validador
    // y que no pida precios, pero especificamos que es una reseña.
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: rating.toString(),
      reviewCount: "1", // Al ser tu propia reseña, el conteo es 1
    },
  },
  reviewRating: {
    "@type": "Rating",
    ratingValue: rating.toString(),
    bestRating: "5",
    worstRating: "1",
  },
  reviewBody: metaDescription,
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
<MainLayout
  isHome={false}
  title={title}
  description={metaDescription}
  image={image.src}
  rating={rating}
  reviewCount={reviewCount}
>
  {
    post.data.type === "Review" && (
      <ReviewTemplate {...post.data}>
        <Content />
      </ReviewTemplate>
    )
  }
</MainLayout>
