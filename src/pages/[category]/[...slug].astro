---
import { getCollection, render } from "astro:content";
import { getImage } from "astro:assets";
import ReviewTemplate from "../../components/templates/ReviewTemplate.astro";
import Card from "../../components/Card.astro";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: {
      category: post.data.category.toLowerCase().replace(/\s+/g, "-"),
      slug: post.id,
    },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;

const {
  image,
  rating,
  title,
  metaTitle,
  metaDescription,
  brand,
  name,
  pubDate,
  updatedDate,
  category,
} = post.data;
const { Content } = await render(post);

const site = Astro.site!.href.replace(/\/$/, "");
const categorySlug = category.toLowerCase();
const pageUrl = `${site}/${categorySlug}/${post.id}/`;

// Imagen para redes sociales y schema (1200px, webp, ligera)
const socialImage = await getImage({ src: image, format: "webp", width: 1200 });
const socialImageUrl = new URL(socialImage.src, Astro.site).href;

// Artículos relacionados: primero misma categoría, luego el resto
const related = allPosts
  .filter((p) => p.id !== post.id)
  .sort(
    (a, b) =>
      Number(b.data.category === category) -
        Number(a.data.category === category) ||
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  )
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `${pageUrl}#product`,
      name,
      image: socialImageUrl,
      description: metaDescription,
      brand: { "@type": "Brand", name: brand },
      review: {
        "@type": "Review",
        "@id": `${pageUrl}#review`,
        name: title,
        reviewBody: metaDescription,
        datePublished: pubDate.toISOString(),
        dateModified: (updatedDate ?? pubDate).toISOString(),
        inLanguage: "es-ES",
        author: {
          "@type": "Person",
          name: "Andrés",
          url: `${site}/sobremi/`,
        },
        publisher: {
          "@type": "Organization",
          name: "MundoBox",
          logo: { "@type": "ImageObject", url: `${site}/logo.png` },
        },
        reviewRating: {
          "@type": "Rating",
          ratingValue: rating,
          bestRating: 5,
          worstRating: 1,
        },
      },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: `${site}/` },
        {
          "@type": "ListItem",
          position: 2,
          name: category,
          item: `${site}/${categorySlug}/`,
        },
        { "@type": "ListItem", position: 3, name, item: pageUrl },
      ],
    },
  ],
};
---

<MainLayout
  title={`${metaTitle} | MundoBox`}
  description={metaDescription}
  image={socialImage.src}
  ogType="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate ?? pubDate}
  schema={schema}
>
  <nav aria-label="Migas de pan" class="mx-auto max-w-6xl px-4 text-sm">
    <a href="/" class="hover:text-primary">Inicio</a> ›
    <a href={`/${categorySlug}/`} class="hover:text-primary">{category}</a> ›
    <span aria-current="page">{name}</span>
  </nav>

  {
    post.data.type === "Análisis" && (
      <ReviewTemplate {...post.data} slug={post.id}>
        <Content />
      </ReviewTemplate>
    )
  }

  {
    related.length > 0 && (
      <section class="mx-auto max-w-6xl px-4">
        <h2>También te puede interesar</h2>
        <ul class="grid grid-cols-1 gap-4 p-0 md:grid-cols-3">
          {related.map((p) => (
            <li class="p-0">
              <Card post={p} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</MainLayout>
