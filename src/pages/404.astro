---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import imgRack from "../images/rack.png";
---

<MainLayout>
  <section class="relative h-full w-full rounded-2xl md:aspect-auto">
    <Image
      alt="Portada MundoBox | blog sobre complementos Crosffit"
      loading="eager"
      quality="high"
      widths={[768, 1024]}
      sizes="100vw"
      format="webp"
      class="h-full w-full object-cover opacity-30"
      src={imgRack}
      alt="Atleta de Crossfit entrenando en el box con material de MundoBox"
    />

    <div
      class="absolute inset-0 flex flex-col items-center justify-center px-4 text-center font-bold"
    >
      <h1 class="text-primary font-barlow-condensed h-min text-9xl">404</h1>

      <h2 class="text-primary capitalize">esta pagina no cuenta</h2>

      <p>Parece que el enlace se ha quedado sin aire o nunca existio</p>

      <div>
        <button class="bg-primary max-w-xl text-black">Volver al Inicio</button>
      </div>
    </div>
  </section>
</MainLayout>
