---
import { getPublishedPosts } from "../lib/posts";
import Card from "../components/Card.astro";
import Presentation from "../components/Presentation.astro";
import MainLayout from "../layouts/MainLayout.astro";
import type { CollectionEntry } from "astro:content";
const imageDefault = "/default.png";

const posts = await getPublishedPosts();

const lastPosts = posts.sort(
  (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) => {
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  },
);

const latestPosts = lastPosts.slice(0, 3);
const currentYear = new Date().getFullYear();
---

<MainLayout
  isHome={true}
  title={`MundoBox | Material de CrossFit: Análisis y Guías de Compra ${currentYear}`}
  description={"Análisis honestos de zapatillas, calleras, combas y suplementos para CrossFit, probados en el box. Descubre qué material merece la pena antes de comprar."}
  image={imageDefault}
>
  <section class="flex flex-col items-center p-0">
    <Presentation />
  </section>

  <section>
    <h2 class="text-center">Últimos análisis</h2>

    <ul class="grid grid-cols-1 gap-2 p-0 md:grid-cols-3">
      {
        latestPosts.map((post) => (
          <li class="p-0">
            <Card post={post} />
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>
