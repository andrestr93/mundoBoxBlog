---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import Presentation from "../components/Presentation.astro";
import MainLayout from "../layouts/MainLayout.astro";
const imageDefault = "/default.png";

const posts = await getCollection("blog");

const lastPosts = posts.sort((a: any, b: any) => {
  return a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
});

const latestPosts = lastPosts.slice(0, 3);
const currentYear = new Date().getFullYear();
---

<MainLayout
  isHome={true}
  title={`MundoBox | Guías de Equipamiento Crossfit y Análisis ${currentYear}`}
  description={"¿Quieres mejorar tus marcas? En MundoBox probamos y analizamos el mejor material de Crossfit en Amazon. De atletas para atletas."}
  image={imageDefault}
>
  <section class="flex flex-col items-center p-0">
    <Presentation />
  </section>

  <section>
    <h2 class="text-center">Ultimos Analisis</h2>

    <ul class="grid grid-cols-1 gap-2 p-0 md:grid-cols-3">
      {
        latestPosts.map((post) => (
          <li class="p-0">
            <Card post={post} />
          </li>
        ))
      }
    </ul>
  </section>
</MainLayout>
