---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import Presentation from "../components/Presentation.astro";
import MainLayout from "../layouts/MainLayout.astro";
const imageDefault = "/default-og.png";
const posts = await getCollection("blog");

const lastPosts = posts.sort((a, b) => {
  return a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
});

const latestPosts = lastPosts.slice(0, 3);
---

<MainLayout
  title={"MundoBox | Reviews y Guías de Equipamiento para Crossfit 2026"}
  description={"Análisis a fondo del mejor material para Crossfit. Comparamos zapatillas, combas, calleras y accesorios para que elijas el equipo perfecto para tu próximo WOD."}
  image={imageDefault}
>
  <Presentation />

  <ul
    class="grid grid-cols-1 gap-2 p-0 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"
  >
    {
      latestPosts.map((post) => (
        <li class="p-0">
          <Card post={post} />
        </li>
      ))
    }
  </ul>
</MainLayout>
